NODE_ENV=secure
PORT=5000
FRONTEND_URL=http://localhost:3000

# База данных
DB_HOST=localhost
DB_PORT=5432
DB_NAME=archimus_secure
DB_USER=postgres
DB_PASSWORD=your_password

# JWT (более короткие токены)
JWT_ACCESS_SECRET=secure_access_secret_key_32_chars_minimum
JWT_REFRESH_SECRET=secure_refresh_secret_key_32_chars_minimum
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Безопасность - ВКЛЮЧЕНА
ENABLE_PASSWORD_VALIDATION=true
ENABLE_RATE_LIMIT=true
ENABLE_2FA=true
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5

# Шифрование (полное)
MASTER_KEY=secure_master_key_32_bytes_minimum
SALT_ROUNDS=10