NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-domain.com

# База данных (продакшн БД)
DB_HOST=production-db-host
DB_PORT=5432
DB_NAME=archimus_prod
DB_USER=prod_user
DB_PASSWORD=strong_password

# JWT (очень сложные ключи)
JWT_ACCESS_SECRET=your_very_strong_production_access_secret
JWT_REFRESH_SECRET=your_very_strong_production_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Безопасность - МАКСИМАЛЬНАЯ
ENABLE_PASSWORD_VALIDATION=true
ENABLE_RATE_LIMIT=true
ENABLE_2FA=true
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5

# Шифрование (максимальное)
MASTER_KEY=production_master_key_very_long_and_secure
SALT_ROUNDS=12