NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# База данных
DB_HOST=localhost
DB_PORT=5432
DB_NAME=archimus
DB_USER=postgres
DB_PASSWORD=root

# JWT
JWT_ACCESS_SECRET=dev_access_secret_key
JWT_REFRESH_SECRET=dev_refresh_secret_key
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Безопасность - ОТКЛЮЧЕНА в режиме разработки
ENABLE_PASSWORD_VALIDATION=false
ENABLE_RATE_LIMIT=false
ENABLE_2FA=false
PASSWORD_MIN_LENGTH=1
MAX_LOGIN_ATTEMPTS=100

# Шифрование (упрощенное для разработки)
MASTER_KEY=dev_master_key
SALT_ROUNDS=1