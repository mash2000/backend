# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=archimus
DB_USER=postgres
DB_PASSWORD=

# Redis (опционально, если не используете - оставьте)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=your_super_secret_access_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Encryption
MASTER_KEY=your_master_encryption_key_32_bytes_minimum
SALT_ROUNDS=10

# File Upload
MAX_FILE_SIZE=104857600
ALLOWED_EXTENSIONS=.mp3,.wav,.flac,.pdf,.mid,.midi,.txt,.mscz,.musicxml,.jpg,.png

# AWS S3 (опционально, для продакшена)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ru-central1
AWS_BUCKET=archimus-files

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_DIR=logs